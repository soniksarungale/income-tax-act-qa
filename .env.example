DATABASE_URL=postgresql://taxqa:taxqa@127.0.0.1:5433/taxqa

# Path to the Act PDF (not committed, see README for the download link and checksum)
ACT_PDF_PATH=data/Income-tax-Act-1961_2026.pdf

# Answer generation provider: claude-cli | openai | anthropic | gemini
# claude-cli runs the locally installed and logged-in Claude Code CLI and needs no key.
LLM_PROVIDER=claude-cli
# Defaults: claude-cli -> sonnet, anthropic -> claude-sonnet-5-5. Required for openai and gemini.
LLM_MODEL=
# Required for openai, anthropic and gemini.
LLM_API_KEY=
CLAUDE_BIN=claude
